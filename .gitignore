# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/

# ============================================================================
# DATA DIRECTORIES
# Rationale: Git is for code/workflow, not large datasets
# All data is reproducible via pipeline scripts from public sources
# ============================================================================

# Raw data (downloaded from NCES, states, etc.)
data/raw/

# Processed data (normalized, merged, validated)
data/processed/

# Enriched data (with calculated metrics, bell schedules)
data/enriched/

# Exported data
data/exports/

# Acquisition pipeline working state (regenerated batches + cross-stage status registry) --
# .example. files ARE tracked (schema reference/documentation, see docs/ACQUISITION_PIPELINE.md)
data/acquisition/queue/batch_*.json
data/acquisition/status/district_status.json

# Data file formats (catch-all for any that slip through)
*.parquet
*.feather
*.sas7bdat

# EXCEPTIONS: Keep small sample/test data for testing
!data/raw/federal/nces-ccd/*/sample_*.csv
!data/test/

# EXCEPTIONS: Keep directory structure documentation
!data/**/README.md
!data/**/.gitkeep

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment
.env
.env.local
config/secrets.yaml
config/secrets.local.json
secrets.local.json
*.key
*.pem
context.xml

# ============================================================================
# OUTPUT DIRECTORIES
# Rationale: Generated artifacts (datasets, reports, visualizations)
# Can be regenerated by running the pipeline
# ============================================================================

# All outputs directory contents (but allow the directory itself)
outputs/*
!outputs/analysis-reports/
!outputs/datasets/
!outputs/reports/
!outputs/current-lct-calculations/

# Generated reports and visualizations (unless in docs)
*.pdf
*.png
*.jpg
*.svg

# EXCEPTIONS: Keep documentation images
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# EXCEPTIONS: Keep specific output files
!outputs/README.md
!outputs/**/.gitkeep
!outputs/datasets/bell_schedules_*.csv
!outputs/datasets/bell_schedules_*.json
!outputs/analysis-reports/**
!outputs/reports/**

# Database
*.db
*.sqlite

# Docker
postgres_data/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temporary
temp/
tmp/
*.tmp
context.xml
data/cache/

# Database backups
backup_*.sql
data/backups/
infrastructure/database/docker/backup/*.sql

# Archived/suspect data
data/archive/

# Test data files (not fixtures)
data/test_cohort*.csv

# Batch processing temp files
tier_*_batch_*.txt

# Local CLAUDE.md config files (per-directory overrides)
# Exclude subdirectory CLAUDE.md files but keep root CLAUDE.md
config/CLAUDE.md
infrastructure/**/CLAUDE.md

# discovery benchmark page captures (binary, regenerable)
data/benchmark_results/discovery/*/captures/

# Stage 4 PDF-tool spike: keep run_spike.py + summary.jsonl (the actual evidence cited in
# REQ-083/ACQUISITION_PIPELINE.md), ignore the 178MB/2000+ files of regenerable raw per-tool
# output and the noisy stdout log.
data/benchmark_results/stage4_pdf_tool_spike/*/
data/benchmark_results/stage4_pdf_tool_spike/run.log
