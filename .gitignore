# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/

# ============================================================================
# DATA DIRECTORIES
# Rationale: Git is for code/workflow, not large datasets
# All data is reproducible via pipeline scripts from public sources
# ============================================================================

# Raw data (downloaded from NCES, states, etc.)
data/raw/

# Processed data (normalized, merged, validated)
data/processed/

# Enriched data (with calculated metrics, bell schedules)
data/enriched/

# Exported data
data/exports/

# Acquisition pipeline working state (regenerated batches) --
# .example. files ARE tracked (schema reference/documentation, see docs/ACQUISITION_PIPELINE.md)
data/acquisition/queue/batch_*.json
# district_status.json is the version-controlled BACKUP of the precious state_event log (REQ-099) --
# regenerated from the governance DB on every save(), re-importable after a wipe (like labels.json).

# Data file formats (catch-all for any that slip through)
*.parquet
*.feather
*.sas7bdat

# EXCEPTIONS: Keep small sample/test data for testing
!data/raw/federal/nces-ccd/*/sample_*.csv
!data/test/

# EXCEPTIONS: Keep directory structure documentation
!data/**/README.md
!data/**/.gitkeep

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment
.env
.env.local
config/secrets.yaml
config/secrets.local.json
secrets.local.json
*.key
*.pem
context.xml

# ============================================================================
# OUTPUT DIRECTORIES
# Rationale: Generated artifacts (datasets, reports, visualizations)
# Can be regenerated by running the pipeline
# ============================================================================

# All outputs directory contents (but allow the directory itself)
outputs/*
!outputs/analysis-reports/
!outputs/datasets/
!outputs/reports/
!outputs/current-lct-calculations/

# Generated reports and visualizations (unless in docs)
*.pdf
*.png
*.jpg
*.svg

# EXCEPTIONS: Keep documentation images
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# scratch-paper is a disposable whiteboard — ignore its contents (the already-tracked README.md stays
# tracked; durable records get promoted to docs/technical-notes / METHODOLOGY, not left here). A parent-dir
# exclude, so the docs/** image negations above do NOT re-include renders dropped in here.
docs/scratch-paper/

# EXCEPTIONS: Keep the Stage 5 review app's vendored UI assets (logo, etc.) — these are part
# of the app, not regenerable capture output.
!infrastructure/acquisition/stage5_filter/review_app/static/assets/**

# EXCEPTIONS: Keep specific output files
!outputs/README.md
!outputs/**/.gitkeep
!outputs/datasets/bell_schedules_*.csv
!outputs/datasets/bell_schedules_*.json
!outputs/analysis-reports/**
!outputs/reports/**

# Database
*.db
*.sqlite

# Docker
postgres_data/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temporary
temp/
tmp/
*.tmp
context.xml
data/cache/

# Database backups
backup_*.sql
data/backups/
infrastructure/database/docker/backup/*.sql

# Archived/suspect data
data/archive/

# Cross-family review harness receipts (regenerable — raw findings, verdicts, spend per run)
data/review/

# Test data files (not fixtures)
data/test_cohort*.csv

# Batch processing temp files
tier_*_batch_*.txt

# Local CLAUDE.md config files (per-directory overrides)
# Exclude subdirectory CLAUDE.md files but keep root CLAUDE.md
config/CLAUDE.md
infrastructure/**/CLAUDE.md

# discovery benchmark page captures (binary, regenerable)
data/benchmark_results/discovery/*/captures/

# Stage 4 PDF-tool spike: keep run_spike.py + summary.jsonl (the actual evidence cited in
# REQ-083/ACQUISITION_PIPELINE.md), ignore the 178MB/2000+ files of regenerable raw per-tool
# output and the noisy stdout log.
data/benchmark_results/stage4_pdf_tool_spike/*/
data/benchmark_results/stage4_pdf_tool_spike/run.log

# Stage 5 review app — ignore the regenerable local SQLite DB, but TRACK the precious,
# version-controlled human-data backups: labels.json (the labels) and cluster_splits.json
# (records the reviewer pulled out of an auto-cluster — a durable override that survives re-ingest).
data/acquisition/stage5_review/*
!data/acquisition/stage5_review/labels.json
!data/acquisition/stage5_review/cluster_splits.json
!data/acquisition/stage5_review/followup_flags.json

# Derived harvest slices (regenerable from captures at ingest; issue #58 relocation)
data/acquisition/harvest_slices/

# Contamination-remediation restore-points (remediate_contamination.py --archive-capture-dir):
# TRACK the small non-regenerable audit record (manifest.json), NEVER the archived raw capture dir
# (hundreds of MB of regenerable PNG/PDF/per-tool output moved out of data/raw).
data/acquisition/remediation/**/archived_capture_dir/
data/acquisition/remediation/**/labels.json
data/acquisition/remediation/**/district_status.json

# hypothesis example DB (#203) + mutation-sweep scratch (#204)
.hypothesis/
mutants/
.mutmut-cache
