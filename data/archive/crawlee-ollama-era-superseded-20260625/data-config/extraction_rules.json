  "description": "Extraction rules learned from pipeline accuracy testing (Phase 9)",

  "negative_time_patterns": {
    "description": "Text patterns that indicate NON-school hours. Skip times near these labels.",
    "patterns": [
      {"label": "Office Hours", "regex": "office\\s+hours?", "action": "skip"},
      {"label": "Library Hours", "regex": "library\\s+hours?", "action": "skip"},
      {"label": "Before Care", "regex": "before\\s+(school\\s+)?care", "action": "skip"},
      {"label": "After Care", "regex": "after\\s+(school\\s+)?care", "action": "skip"},
      {"label": "Extended Day", "regex": "extended\\s+day", "action": "skip"},
      {"label": "Breakfast Program", "regex": "breakfast\\s+(starts?|begins?|served)", "action": "skip"},
      {"label": "Campus Closes", "regex": "campus\\s+closes?", "action": "skip"},
      {"label": "Building Hours", "regex": "building\\s+hours?", "action": "skip"}
    ]
  },

  "positive_time_patterns": {
    "description": "Text patterns that strongly indicate actual school hours. Prioritize these.",
    "patterns": [
      {"label": "School Hours", "regex": "school\\s+hours?", "weight": 1.0},
      {"label": "School Begins", "regex": "school\\s+begins?", "weight": 1.0},
      {"label": "Dismissal", "regex": "dismissal", "weight": 1.0},
      {"label": "School Starts", "regex": "school\\s+starts?", "weight": 1.0},
      {"label": "First Bell", "regex": "first\\s+bell", "weight": 0.9},
      {"label": "Tardy Bell", "regex": "tardy\\s+bell", "weight": 0.8},
      {"label": "Start Day", "regex": "start\\s+day", "weight": 0.9},
      {"label": "End of Day", "regex": "end\\s+of\\s+day", "weight": 0.9}
    ]
  },

