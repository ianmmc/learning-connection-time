#!/bin/bash
# Pre-commit hook for Learning Connection Time project
#
# TRACKED + SHARED: this hook lives in .githooks/ (version-controlled) and is activated per clone with
#   git config core.hooksPath .githooks
# (one-time; see docs/GETTING_STARTED.md "Git hooks"). A local .git/hooks/pre-commit, if present, is
# ignored once core.hooksPath is set. Editing this file is the single source of truth — no copy step.
#
# It does two things:
#  1. Sweep the PRECIOUS-state JSON backups into every commit so they never drift behind the DB.
#  2. Validate enrichment claims in staged docs against the DB (prevents hallucinated counts — Rule #6).

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}Running pre-commit validation...${NC}"

# Precious-state backups: the governance DB (Postgres) is authoritative, but these git-tracked JSON
# files are the re-importable backups (written on every save/ingest; restore after a DB wipe). They are
# managed SYMMETRICALLY — always swept into the commit so a labeling / pipeline pass is never left
# behind on a sync to GitHub. git add on an unchanged file is a harmless no-op.
#   - labels.json          <- the `label` table        (export_labels on every build_signals ingest)
#   - district_status.json <- the `state_event` log    (export_status on every DS.save)
#   - cluster_splits.json  <- the `cluster_split` table (export_splits on every split; issue #57)
#   - followup_flags.json  <- the `followup_flag` table (_backup_followups on every flag; issue #57)
# The [ -f ] guard means a backup that doesn't exist yet (e.g. no follow-up flag ever created) is
# skipped gracefully.
PRECIOUS_BACKUPS=(
    "data/acquisition/stage5_review/labels.json"
    "data/acquisition/status/district_status.json"
    "data/acquisition/stage5_review/cluster_splits.json"
    "data/acquisition/stage5_review/followup_flags.json"
    "data/acquisition/status/gate_modes.json"
    "data/acquisition/status/stage8_approvals.json"
)
for f in "${PRECIOUS_BACKUPS[@]}"; do
    if [ -f "$f" ]; then
        git add "$f"
        echo -e "${GREEN}Ensured $f is staged${NC}"
    fi
done

# REQUIREMENTS.yaml must parse when staged (issue #77 — it was once broken YAML for an
# unknown period; the ledger being machine-readable is load-bearing)
if git diff --cached --name-only | grep -q '^docs/REQUIREMENTS.yaml$'; then
    if ! python3 -c "import yaml; yaml.safe_load(open('docs/REQUIREMENTS.yaml'))" 2>/dev/null; then
        echo -e "${RED}docs/REQUIREMENTS.yaml does not parse as YAML — fix before committing${NC}"
        python3 -c "import yaml; yaml.safe_load(open('docs/REQUIREMENTS.yaml'))" 2>&1 | head -5
        exit 1
    fi
    echo -e "${GREEN}REQUIREMENTS.yaml parses OK${NC}"
fi

# Check if any documentation files are being committed
DOC_FILES=$(git diff --cached --name-only | grep -E '\.(md|yaml|yml)$' || true)

if [ -z "$DOC_FILES" ]; then
    echo -e "${GREEN}No documentation files staged - skipping enrichment validation${NC}"
    exit 0
fi

# Check if any files mention enrichment counts
ENRICHMENT_CLAIMS=$(git diff --cached --name-only | xargs grep -l -E 'enriched.*districts|bell.*schedule.*count|[0-9]+.*districts.*enriched' 2>/dev/null || true)

if [ -z "$ENRICHMENT_CLAIMS" ]; then
    echo -e "${GREEN}No enrichment claims detected - proceeding${NC}"
    exit 0
fi

echo -e "${YELLOW}Enrichment claims detected in:${NC}"
echo "$ENRICHMENT_CLAIMS"
echo ""

# Verify claims against database
echo -e "${YELLOW}Verifying enrichment claims against database...${NC}"

# Run Python verification script
PYTHONPATH="$(git rev-parse --show-toplevel)" python3 << 'PYEOF'
import sys
try:
    from infrastructure.database.connection import session_scope
    from sqlalchemy import text

    with session_scope() as session:
        # Get actual count
        result = session.execute(text(
            "SELECT COUNT(DISTINCT district_id) FROM bell_schedules"
        ))
        actual_count = result.scalar()

        print(f"Database verification: {actual_count} districts have bell schedules")
        print(f"Timestamp: $(date -u +%Y-%m-%dT%H:%M:%SZ)")

        # Success
        sys.exit(0)

except Exception as e:
    print(f"Warning: Could not verify database - {e}")
    print("Proceeding with commit (manual verification recommended)")
    sys.exit(0)
PYEOF

VERIFY_RESULT=$?

if [ $VERIFY_RESULT -ne 0 ]; then
    echo -e "${RED}Enrichment verification failed!${NC}"
    echo -e "${RED}Please verify your enrichment claims match the database.${NC}"
    echo ""
    echo "To verify manually:"
    echo "  python3 -c \"from infrastructure.database.connection import session_scope; from sqlalchemy import text; s = session_scope().__enter__(); print(s.execute(text('SELECT COUNT(DISTINCT district_id) FROM bell_schedules')).scalar())\""
    exit 1
fi

echo -e "${GREEN}Pre-commit validation passed!${NC}"
exit 0
